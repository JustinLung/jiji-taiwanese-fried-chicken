{"_id":"homePage","_type":"homePage","hero":{"_type":"object","eyebrow":"Authentic Taipei Night Market Recipe","title":"Crispy.\nJuicy.\nTaiwanese.","description":"Experience the ultimate crunch of our jumbo fried chicken cutlets. Infused with aromatic five-spice, white pepper, and fresh basil, fried to absolute golden perfection.","image":{"_type":"image","alt":"JiJi team preparing Taiwanese fried chicken in the kitchen"},"primaryAction":{"_type":"object","label":"Find Us","href":"https://www.google.com/maps/dir//JiJi+Taiwanese+Fried+Chicken,+Leidsekruisstraat+10,+1017+RH+Amsterdam/@51.9879228,5.9532538,14z/data=!4m8!4m7!1m0!1m5!1m1!1s0x47c60958136c19a5:0x3d689e1ed8529ab8!2m2!1d4.8852537!2d52.3638403?entry=ttu&g_ep=EgoyMDI2MDUxMS4wIKXMDSoASAFQAw%3D%3D","target":"_blank"},"secondaryAction":{"_type":"object","label":"View Full Menu","href":"/menu","target":"_self","variant":"secondary"},"usps":[{"_key":"fresh-daily","_type":"object","label":"100% Fresh Daily"},{"_key":"pepper-salt","_type":"object","label":"Secret Pepper Salt Mix"},{"_key":"made-to-order","_type":"object","label":"Made-To-Order Crispness"}],"sizeBadge":{"_type":"object","ariaLabel":"XL size, 100% Halal!","eyebrow":"XL Size","label":"100% Halal!"},"quote":{"_type":"object","eyebrow":"Jiji says:","text":"“Crispiest bite you'll ever have!”","avatar":{"_type":"image","alt":""}}},"menuSection":{"_type":"object","eyebrow":"Taste The Street Food Sensation","title":"JiJi Signature Favorites","description":"Prepared fresh with premium ingredients and our secret Taipei night market seasoning blend. Always hot, always crunchy.","featuredItems":[{"_key":"classic-jiji-xxl-chicken-cutlet","_type":"reference","_ref":"menuItem.classic-jiji-xxl-chicken-cutlet"},{"_key":"taiwanese-popcorn-chicken","_type":"reference","_ref":"menuItem.taiwanese-popcorn-chicken"},{"_key":"sichuan-chili-glazed-bites","_type":"reference","_ref":"menuItem.sichuan-chili-glazed-bites"},{"_key":"plum-dusted-sweet-potato-fries","_type":"refere